---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	classify(classify)
	retrieve(retrieve)
	generate(generate)
	aggregate(aggregate)
	refuse(refuse)
	validate(validate)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> classify;
	aggregate --> validate;
	classify -.-> aggregate;
	classify -. &nbsp;out_of_scope&nbsp; .-> refuse;
	classify -. &nbsp;lookup&nbsp; .-> retrieve;
	generate --> validate;
	refuse --> validate;
	retrieve --> generate;
	validate -. &nbsp;done&nbsp; .-> finalize;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

